generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// USER & ROLE

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  users User[]
}

model User {
  id        Int     @id @default(autoincrement())
  fullName  String
  email     String  @unique
  phone     String? @unique
  password  String
  isActive  Boolean @default(true)
  roleId    Int

  role Role @relation(fields: [roleId], references: [id])
}

//////////////////////////////////////////////////////
// TABLE & CUSTOMER

model Table {
  id      Int    @id @default(autoincrement())
  number  Int    @unique
  name    String
  qrCode  String @unique
  status  String @default("available")

  orders   Order[]
  scanLogs QrScanLog[]
}

model Customer {
  id       Int    @id @default(autoincrement())
  fullName String
  phone    String @unique

  orders Order[]
}

//////////////////////////////////////////////////////
// CATEGORY & MENU

model Category {
  id   Int    @id @default(autoincrement())
  name String

  menuItems MenuItem[]
}

model MenuItem {
  id          Int     @id @default(autoincrement())
  name        String
  price       Float
  isAvailable Boolean @default(true)
  categoryId  Int

  category Category @relation(fields: [categoryId], references: [id])

  bom       MenuItemBOM[]
  items     OrderItem[]

  // 🔥 ADD THIS LINE
  cartItems CartItem[]
}

//////////////////////////////////////////////////////
// BOM & INVENTORY

model Ingredient {
  id            Int     @id @default(autoincrement())
  name          String
  stockQuantity Float

  movements StockMovement[]
  bomItems  MenuItemBOM[]
}

model MenuItemBOM {
  id           Int     @id @default(autoincrement())
  menuItemId   Int
  ingredientId Int
  quantity     Float

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model StockMovement {
  id           Int      @id @default(autoincrement())
  ingredientId Int
  type         String
  quantity     Float
  note         String?
  createdAt    DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

//////////////////////////////////////////////////////
// ORDER SYSTEM

model Order {
  id            Int      @id @default(autoincrement())
  tableId       Int
  customerId    Int?
  customerName  String?
  customerPhone String?
  notes         String?
  total         Float
  status        String
  createdAt     DateTime @default(now())

  table    Table    @relation(fields: [tableId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  items      OrderItem[]
  payments   Payment[]
  logs       OrderStatusHistory[]
  invoice    Invoice?
}

model OrderItem {
  id         Int   @id @default(autoincrement())
  orderId    Int
  menuItemId Int
  quantity   Int
  unitPrice  Float

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

//////////////////////////////////////////////////////
// ORDER STATUS HISTORY

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int
  status    String
  changedBy Int?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// PAYMENT SYSTEM

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  amount    Float
  status    String
  method    String?
  createdAt DateTime @default(now())

  order        Order                @relation(fields: [orderId], references: [id])
  transactions PaymentTransaction[]
}

model PaymentTransaction {
  id         Int      @id @default(autoincrement())
  paymentId  Int
  amount     Float
  method     String
  status     String
  reference  String?
  createdAt  DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// NOTIFICATIONS

model Notification {
  id         Int      @id @default(autoincrement())
  title      String
  message    String
  role       String
  orderId    Int?
  customerId Int?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

//////////////////////////////////////////////////////
// CART SYSTEM

model Cart {
  id        Int      @id @default(autoincrement())
  tableId   Int?
  createdAt DateTime @default(now())

  items CartItem[]
}

model CartItem {
  id         Int @id @default(autoincrement())
  cartId     Int
  menuItemId Int
  quantity   Int

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

//////////////////////////////////////////////////////
// SETTINGS

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

//////////////////////////////////////////////////////
// QR SCAN LOG

model QrScanLog {
  id        Int      @id @default(autoincrement())
  tableId   Int
  scannedAt DateTime @default(now())

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// INVOICE

model Invoice {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  total     Float
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// AUDIT LOG

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  Int
  userId    Int?
  createdAt DateTime @default(now())
}